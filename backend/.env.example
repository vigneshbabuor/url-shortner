# LinkPulse backend configuration.
# Copy to .env (in backend/) and adjust. Do not commit the real .env.

# HTTP port the server listens on.
PORT=3000

# Path to the SQLite database file.
DB_FILE=./data.db

# Public base URL used when building short links (set when behind a proxy or
# custom domain, e.g. https://links.example.com). Leave empty to derive from
# the incoming request host.
BASE_URL=

# API key required in the `x-api-key` header on POST /shorten.
# Leave empty to disable the guard. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=
